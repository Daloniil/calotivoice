# cp .env.example .env

DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
COMPOSE_PARALLEL_LIMIT=4

# Go в Docker → ML на Mac (host.docker.internal)
STT_UPSTREAM_URL=http://host.docker.internal:8091
# STT ждёт guard+intake внутри POST /v1/transcribe (Docker: guard/intake по имени сервиса)
STT_PIPELINE_TIMEOUT_SEC=180
GUARD_UPSTREAM_URL=http://host.docker.internal:8092
INTAKE_UPSTREAM_URL=http://host.docker.internal:1234/v1
INTAKE_MODEL=qwen/qwen3.8-27b
INTAKE_MAX_TOKENS=2048

# AWS (SES + SQS)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AUTH_EMAIL_FROM=noreply@your-domain.xyz

SQS_STT_TRANSCRIPT_QUEUE_URL=
SQS_GUARD_APPROVED_QUEUE_URL=
